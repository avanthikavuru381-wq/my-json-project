      "parameters": {
        "jsCode": "const webhookData = $('Webhook').first().json;\nconst question = webhookData.body ? webhookData.body.question : webhookData.question;\nconst text = $input.first().json.text;\n\n// Aggressively clean the text\nconst cleanText = text\n  .replace(/[\\r\\n\\t]/g, ' ')\n  .replace(/\"/g, \"'\")\n  .replace(/\\\\/g, ' ')\n  .replace(/[\\x00-\\x1F\\x7F]/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .substring(0, 400)\n  .trim();\n\nconst cleanQuestion = question\n  .replace(/\"/g, \"'\")\n  .replace(/[\\x00-\\x1F\\x7F]/g, ' ')\n  .trim();\n\nreturn [{\n  json: {\n    question: cleanQuestion,\n    cleanText: cleanText,\n    userMessage: \"Answer this: \" + cleanQuestion + \" Text: \" + cleanText\n  }\n}];"
      },
